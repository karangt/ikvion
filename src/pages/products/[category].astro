---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const modules = await Promise.all([
    import('../../content/products/neck-aids.json'),
    import('../../content/products/shoulder-aids.json'),
    import('../../content/products/forearm-wrist-aids.json'),
    import('../../content/products/finger-aids.json'),
    import('../../content/products/chest-rib-back-aids.json'),
    import('../../content/products/abdomen-pelvic-aids.json'),
    import('../../content/products/knee-calf-aids.json'),
    import('../../content/products/ankle-aids.json'),
    import('../../content/products/foot-aids.json'),
    import('../../content/products/traction-comfort.json'),
    import('../../content/products/walking-aids.json'),
  ]);

  return modules.map(mod => {
    const cat = mod.default;
    return {
      params: { category: cat.slug },
      props: { data: cat },
    };
  });
}

const { data } = Astro.props;
---

<BaseLayout title={data.title} description={data.description}>

  <!-- Page Header -->
  <div style="background-color: #1B2A4A;" class="py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <nav class="text-sm text-gray-400 mb-3">
        <a href={`${base}`} class="hover:text-[#4ABFBF]">Home</a>
        <span class="mx-2">/</span>
        <a href={`${base}products/`} class="hover:text-[#4ABFBF]">Products</a>
        <span class="mx-2">/</span>
        <span class="text-white">{data.title}</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Playfair Display', serif;">
        {data.title}
      </h1>
      <p class="text-gray-300 mt-2 max-w-2xl">{data.description}</p>
    </div>
  </div>

  <!-- Products Grid -->
  <section class="py-12 px-4 sm:px-6 lg:px-8" style="background-color: #F5F0EB;">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {data.products.map((product: { sku: string; name: string; sizes: string }) => (
          <div class="bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-md transition-shadow">
            <!-- Product image -->
            <div class="h-48 flex items-center justify-center overflow-hidden" style="background-color: #F5F0EB;">
              <img
                src={`${base}images/products/${data.slug}/${product.sku}.png`}
                alt={product.name}
                class="h-full w-full object-contain p-3"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="font-semibold mb-1 text-sm" style="color: #1B2A4A;">{product.name}</h3>
              <p class="text-xs text-gray-500 mb-2">Size: {product.sizes}</p>
              <span class="inline-block text-xs font-mono px-2 py-0.5 rounded" style="background-color: #F5F0EB; color: #1B2A4A;">
                {product.sku}
              </span>
            </div>
          </div>
        ))}
      </div>

      <!-- Enquire CTA -->
      <div class="mt-10 p-6 bg-white rounded-xl text-center shadow-sm">
        <p class="text-gray-600 mb-4">Interested in {data.title}? Get pricing and availability.</p>
        <a
          href={`${base}contact/`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white hover:opacity-90 transition-opacity"
          style="background-color: #1B2A4A;"
        >
          Enquire About This Category
        </a>
      </div>
    </div>
  </section>

  <!-- Back to Products -->
  <div class="bg-white py-6 px-4 sm:px-6 lg:px-8 text-center">
    <a
      href={`${base}products/`}
      class="inline-flex items-center gap-2 text-sm font-medium text-[#4ABFBF] hover:underline"
    >
      <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      Back to All Products
    </a>
  </div>

</BaseLayout>
