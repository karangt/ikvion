---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const modules = await Promise.all([
    import('../../content/products/neck-aids.json'),
    import('../../content/products/shoulder-aids.json'),
    import('../../content/products/forearm-wrist-aids.json'),
    import('../../content/products/finger-aids.json'),
    import('../../content/products/chest-rib-back-aids.json'),
    import('../../content/products/abdomen-pelvic-aids.json'),
    import('../../content/products/knee-calf-aids.json'),
    import('../../content/products/ankle-aids.json'),
    import('../../content/products/foot-aids.json'),
    import('../../content/products/traction-comfort.json'),
    import('../../content/products/walking-aids.json'),
  ]);

  return modules.map(mod => {
    const cat = mod.default;
    return {
      params: { category: cat.slug },
      props: { data: cat },
    };
  });
}

const { data } = Astro.props;

// Force 3-column grid for chest-rib-back-aids (6 products → 3+3)
const forceThreeCols = data.slug === 'chest-rib-back-aids';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${data.title} — Ikvion`,
  description: data.description,
  itemListElement: data.products.map((product: { sku: string; name: string; sizes: string }, index: number) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: product.name,
      sku: product.sku,
      description: `${product.name} — Available in sizes: ${product.sizes}`,
      brand: { '@type': 'Brand', name: 'Ikvion' },
      offers: {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        priceCurrency: 'USD',
        seller: { '@type': 'Organization', name: 'Ikvion Group of Companies' },
      },
    },
  })),
};
---

<BaseLayout
  title={`${data.title} — Orthopedic Aids`}
  description={`${data.description} Manufactured by Ikvion, Pune — ISO 9001:2008 & WHO GMP certified exporter.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <!-- Page Header -->
  <div style="background-color: #1B2A4A;" class="py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <nav class="text-sm text-gray-400 mb-3">
        <a href={`${base}`} class="hover:text-[#4ABFBF]">Home</a>
        <span class="mx-2">/</span>
        <a href={`${base}products/`} class="hover:text-[#4ABFBF]">Products</a>
        <span class="mx-2">/</span>
        <span class="text-white">{data.title}</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Playfair Display', serif;">
        {data.title}
      </h1>
      <p class="text-gray-300 mt-2 max-w-2xl">{data.description}</p>
    </div>
  </div>

  <!-- Products Grid -->
  <section class="py-12 px-4 sm:px-6 lg:px-8" style="background-color: #F5F0EB;">
    <div class="max-w-7xl mx-auto">
      <div class={`grid gap-5 ${forceThreeCols ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'}`}>
        {data.products.map((product: { sku: string; name: string; sizes: string; features?: string[]; benefits?: string[] }) => (
          <button
            type="button"
            class="product-card group bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-md transition-shadow text-left w-full cursor-pointer"
            data-product={JSON.stringify(product)}
            data-slug={data.slug}
            data-base={base}
          >
            <!-- Product image -->
            <div class="h-56 flex items-center justify-center overflow-hidden" style="background-color: #F5F0EB;">
              <img
                src={`${base}images/products/${data.slug}/${product.sku}.png`}
                alt={product.name}
                class="h-full w-full object-contain p-4"
                style="mix-blend-mode: multiply;"
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="font-semibold mb-1 text-sm group-hover:text-[#4ABFBF] transition-colors" style="color: #1B2A4A;">{product.name}</h3>
              <p class="text-xs text-gray-500 mb-2">Sizes: {product.sizes}</p>
              <div class="flex items-center justify-between">
                <span class="inline-block text-xs font-mono px-2 py-0.5 rounded" style="background-color: #F5F0EB; color: #1B2A4A;">
                  {product.sku}
                </span>
                <span class="text-xs text-[#4ABFBF] font-medium">View details →</span>
              </div>
            </div>
          </button>
        ))}
      </div>

      <!-- Enquire CTA -->
      <div class="mt-10 p-6 bg-white rounded-xl text-center shadow-sm">
        <p class="text-gray-600 mb-4">Interested in {data.title}? Get pricing and availability.</p>
        <a
          href={`${base}contact/`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white hover:opacity-90 transition-opacity"
          style="background-color: #1B2A4A;"
        >
          Enquire
        </a>
      </div>
    </div>
  </section>

  <!-- Back to Products -->
  <div class="bg-white py-6 px-4 sm:px-6 lg:px-8 text-center">
    <a
      href={`${base}products/`}
      class="inline-flex items-center gap-2 text-sm font-medium text-[#4ABFBF] hover:underline"
    >
      <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      Back to All Products
    </a>
  </div>

  <!-- Product Detail Modal -->
  <div
    id="product-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4"
    style="background-color: rgba(27,42,74,0.6); backdrop-filter: blur(4px);"
  >
    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto relative">
      <!-- Close -->
      <button
        id="modal-close"
        class="absolute top-4 right-4 text-gray-400 hover:text-[#1B2A4A] transition-colors z-10"
        aria-label="Close"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <!-- Image -->
      <div class="h-64 flex items-center justify-center rounded-t-2xl" style="background-color: #F5F0EB;">
        <img id="modal-image" src="" alt="" class="h-full w-full object-contain p-6" style="mix-blend-mode: multiply;" />
      </div>

      <!-- Content -->
      <div class="p-6">
        <div class="flex items-start justify-between gap-4 mb-1">
          <h2 id="modal-name" class="text-xl font-bold" style="color: #1B2A4A; font-family: 'Playfair Display', serif;"></h2>
          <span id="modal-sku" class="shrink-0 text-xs font-mono px-2 py-1 rounded mt-1" style="background-color: #F5F0EB; color: #1B2A4A;"></span>
        </div>
        <p id="modal-sizes" class="text-sm text-gray-500 mb-5"></p>

        <!-- Features -->
        <div id="modal-features-section" class="mb-5">
          <h3 class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: #4ABFBF;">Features</h3>
          <ul id="modal-features" class="space-y-1.5"></ul>
        </div>

        <!-- Benefits -->
        <div id="modal-benefits-section" class="mb-6">
          <h3 class="text-sm font-semibold uppercase tracking-wider mb-2" style="color: #4ABFBF;">Benefits</h3>
          <ul id="modal-benefits" class="space-y-1.5"></ul>
        </div>

        <!-- Actions -->
        <a
          id="modal-enquire"
          href={`${base}contact/`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white hover:opacity-90 transition-opacity w-full justify-center"
          style="background-color: #1B2A4A;"
        >
          Enquire About This Product
        </a>
      </div>
    </div>
  </div>

</BaseLayout>

<script>
  const modal = document.getElementById('product-modal') as HTMLElement;
  const modalClose = document.getElementById('modal-close');

  function openModal(product: { sku: string; name: string; sizes: string; features?: string[]; benefits?: string[] }, slug: string, base: string) {
    (document.getElementById('modal-image') as HTMLImageElement).src = `${base}images/products/${slug}/${product.sku}.png`;
    (document.getElementById('modal-image') as HTMLImageElement).alt = product.name;
    (document.getElementById('modal-name') as HTMLElement).textContent = product.name;
    (document.getElementById('modal-sku') as HTMLElement).textContent = product.sku;
    (document.getElementById('modal-sizes') as HTMLElement).textContent = `Available sizes: ${product.sizes}`;

    const featuresSection = document.getElementById('modal-features-section') as HTMLElement;
    const featuresList = document.getElementById('modal-features') as HTMLElement;
    if (product.features && product.features.length) {
      featuresList.innerHTML = product.features.map(f =>
        `<li class="flex items-start gap-2 text-sm text-gray-600"><span class="mt-1 shrink-0 w-4 h-4 rounded-full flex items-center justify-center" style="background-color:rgba(74,191,191,0.15);color:#4ABFBF;font-size:10px;">✓</span>${f}</li>`
      ).join('');
      featuresSection.style.display = '';
    } else {
      featuresSection.style.display = 'none';
    }

    const benefitsSection = document.getElementById('modal-benefits-section') as HTMLElement;
    const benefitsList = document.getElementById('modal-benefits') as HTMLElement;
    if (product.benefits && product.benefits.length) {
      benefitsList.innerHTML = product.benefits.map(b =>
        `<li class="flex items-start gap-2 text-sm text-gray-600"><span class="mt-1 shrink-0 w-4 h-4 rounded-full flex items-center justify-center" style="background-color:rgba(74,191,191,0.15);color:#4ABFBF;font-size:10px;">✓</span>${b}</li>`
      ).join('');
      benefitsSection.style.display = '';
    } else {
      benefitsSection.style.display = 'none';
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.product-card').forEach(card => {
    card.addEventListener('click', () => {
      const product = JSON.parse((card as HTMLElement).dataset.product || '{}');
      const slug = (card as HTMLElement).dataset.slug || '';
      const base = (card as HTMLElement).dataset.base || '/';
      openModal(product, slug, base);
    });
  });

  modalClose?.addEventListener('click', closeModal);
  modal?.addEventListener('click', e => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
</script>
