---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

export async function getStaticPaths() {
  const modules = await Promise.all([
    import('../../content/products/neck-aids.json'),
    import('../../content/products/shoulder-aids.json'),
    import('../../content/products/forearm-wrist-aids.json'),
    import('../../content/products/finger-aids.json'),
    import('../../content/products/chest-rib-back-aids.json'),
    import('../../content/products/abdomen-pelvic-aids.json'),
    import('../../content/products/knee-calf-aids.json'),
    import('../../content/products/ankle-aids.json'),
    import('../../content/products/foot-aids.json'),
    import('../../content/products/traction-comfort.json'),
    import('../../content/products/walking-aids.json'),
  ]);

  return modules.map(mod => {
    const cat = mod.default;
    return {
      params: { category: cat.slug },
      props: { data: cat },
    };
  });
}

const { data } = Astro.props;

// Force 3-column grid for specific categories
const forceThreeCols = ['chest-rib-back-aids', 'traction-comfort', 'forearm-wrist-aids'].includes(data.slug);

// Non-face images where product is in the lower half of the frame
const bottomPositionSkus = new Set(['IK-AA-01', 'IK-AA-02', 'IK-AA-03']);



const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${data.title} — Ikvion`,
  description: data.description,
  itemListElement: data.products.map((product: { sku: string; name: string; sizes: string }, index: number) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Product',
      name: product.name,
      sku: product.sku,
      description: `${product.name} — Available in sizes: ${product.sizes}`,
      brand: { '@type': 'Brand', name: 'Ikvion' },
      offers: {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        priceCurrency: 'USD',
        seller: { '@type': 'Organization', name: 'Ikvion Group of Companies' },
      },
    },
  })),
};
---

<BaseLayout
  title={`${data.title} — Orthopedic Aids`}
  description={`${data.description} Manufactured by Ikvion, Pune — ISO 9001:2008 & WHO GMP certified exporter.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <!-- Page Header -->
  <div style="background-color: #0F1F54;" class="py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <nav class="text-sm text-gray-400 mb-3">
        <a href={`${base}`} class="hover:text-[#0D9488]">Home</a>
        <span class="mx-2">/</span>
        <a href={`${base}products/`} class="hover:text-[#0D9488]">Products</a>
        <span class="mx-2">/</span>
        <span class="text-white">{data.title}</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Playfair Display', serif;">
        {data.title}
      </h1>
      <p class="text-gray-300 mt-2 max-w-2xl">{data.description}</p>
    </div>
  </div>

  <!-- Products Grid -->
  <section class="py-12 px-4 sm:px-6 lg:px-8" style="background-color: #FFFFFF;">
    <div class="max-w-7xl mx-auto">
      <div class={`grid gap-5 ${forceThreeCols ? 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3' : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4'}`}>
        {data.products.map((product: { sku: string; name: string; sizes: string; features?: string[]; benefits?: string[] }) => (
          <button
            type="button"
            class="product-card group bg-white rounded-xl shadow-sm overflow-hidden hover:shadow-md transition-shadow text-left w-full cursor-pointer"
            data-product={JSON.stringify(product)}
            data-slug={data.slug}
            data-base={base}
            data-sku={product.sku}
          >
            <div class="h-56 flex items-center justify-center overflow-hidden" style="background-color: #FFFFFF;">
              <img
                src={`${base}images/products/${data.slug}/${product.sku}.png`}
                alt={product.name}
                class="h-full w-full object-cover"
                style={`mix-blend-mode: multiply; object-position: ${bottomPositionSkus.has(product.sku) ? 'bottom' : 'center'};`}
                loading="lazy"
              />
            </div>
            <div class="p-4">
              <h3 class="font-semibold mb-1 text-sm group-hover:text-[#0D9488] transition-colors" style="color: #0F1F54;">{product.name}</h3>
              <p class="text-xs text-gray-500 mb-2">Sizes: {product.sizes}</p>
              <div class="flex items-center justify-between">
                <span class="inline-block text-xs font-mono px-2 py-0.5 rounded" style="background-color: #FFFFFF; color: #0F1F54;">
                  {product.sku}
                </span>
                <span class="text-xs text-[#0D9488] font-medium">View details →</span>
              </div>
            </div>
          </button>
        ))}
      </div>

      <!-- Enquire CTA -->
      <div class="mt-10 p-6 bg-white rounded-xl text-center shadow-sm">
        <p class="text-gray-600 mb-4">Interested in {data.title}? Get pricing and availability.</p>
        <a
          href={`${base}contact/?product=${encodeURIComponent(data.title)}`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white hover:opacity-90 transition-opacity"
          style="background-color: #0F1F54;"
        >
          Enquire
        </a>
      </div>
    </div>
  </section>

  <!-- Back to Products -->
  <div class="bg-white py-6 px-4 sm:px-6 lg:px-8 text-center">
    <a
      href={`${base}products/`}
      class="inline-flex items-center gap-2 text-sm font-medium text-[#0D9488] hover:underline"
    >
      <svg class="w-4 h-4 rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      Back to All Products
    </a>
  </div>

  <!-- Product Detail Modal -->
  <div
    id="product-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4"
    style="background-color: rgba(15,31,84,0.6); backdrop-filter: blur(4px);"
  >
    <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full relative flex flex-col" style="height: 90vh;">

      <!-- Close -->
      <button
        id="modal-close"
        class="absolute top-4 right-4 text-gray-400 hover:text-[#0F1F54] transition-colors z-10"
        aria-label="Close"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <!-- FIXED: Image -->
      <div class="shrink-0 h-56 flex items-center justify-center rounded-t-2xl" style="background-color: #FFFFFF;">
        <img id="modal-image" src="" alt="" class="h-full w-full object-contain p-6" style="mix-blend-mode: multiply;" />
      </div>

      <!-- FIXED: Title / SKU / Sizes -->
      <div class="shrink-0 px-6 py-4" style="border-bottom: 1px solid #f0f0f0;">
        <div class="flex items-start justify-between gap-4">
          <h2 id="modal-name" class="text-xl font-bold" style="color: #0F1F54; font-family: 'Playfair Display', serif;"></h2>
          <span id="modal-sku" class="shrink-0 text-xs font-mono px-2 py-1 rounded mt-1" style="background-color: #f1f5f9; color: #0F1F54;"></span>
        </div>
        <p id="modal-sizes" class="text-sm text-gray-500 mt-1"></p>
      </div>

      <!-- SCROLLABLE: Content -->
      <div class="flex-1 overflow-y-auto px-6 py-5">

        <!-- Short description -->
        <p id="modal-short-desc" class="text-sm text-gray-600 mb-5" style="line-height: 1.65;"></p>

        <!-- Full description -->
        <div id="modal-desc-section" class="mb-5">
          <h3 class="text-xs font-bold uppercase tracking-widest mb-3" style="color: #0D9488;">About This Product</h3>
          <div id="modal-desc" class="text-sm text-gray-600 space-y-2" style="line-height: 1.65;"></div>
        </div>

        <!-- Features -->
        <div id="modal-features-section" class="mb-5">
          <h3 class="text-xs font-bold uppercase tracking-widest mb-3" style="color: #0D9488;">Key Features</h3>
          <ul id="modal-features" class="space-y-1.5"></ul>
        </div>

        <!-- Benefits -->
        <div id="modal-benefits-section" class="mb-5">
          <h3 class="text-xs font-bold uppercase tracking-widest mb-3" style="color: #0D9488;">Benefits</h3>
          <ul id="modal-benefits" class="space-y-1.5"></ul>
        </div>

        <!-- Recommended Use -->
        <div id="modal-rec-section" class="mb-5">
          <h3 class="text-xs font-bold uppercase tracking-widest mb-3" style="color: #0D9488;">Recommended Use</h3>
          <div id="modal-rec" class="flex flex-wrap gap-2"></div>
        </div>

        <!-- Specifications -->
        <div id="modal-specs-section" class="mb-5">
          <h3 class="text-xs font-bold uppercase tracking-widest mb-3" style="color: #0D9488;">Specifications</h3>
          <div id="modal-specs"></div>
        </div>

        <!-- FAQs -->
        <div id="modal-faqs-section" class="mb-2">
          <h3 class="text-xs font-bold uppercase tracking-widest mb-3" style="color: #0D9488;">FAQs</h3>
          <div id="modal-faqs" class="space-y-4"></div>
        </div>

      </div>

      <!-- FIXED: Enquire footer -->
      <div class="shrink-0 px-6 py-4" style="border-top: 1px solid #f0f0f0;">
        <a
          id="modal-enquire"
          href={`${base}contact/`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white hover:opacity-90 transition-opacity w-full justify-center"
          style="background-color: #0F1F54;"
        >
          Enquire About This Product
        </a>
      </div>

    </div>
  </div>

</BaseLayout>

<script>
  const modal = document.getElementById('product-modal') as HTMLElement;
  const modalClose = document.getElementById('modal-close');

  function show(id: string, condition: boolean) {
    (document.getElementById(id) as HTMLElement).style.display = condition ? '' : 'none';
  }

  function checkItem(text: string) {
    return `<li class="flex items-start gap-2 text-sm text-gray-600"><span class="mt-1 shrink-0 w-4 h-4 rounded-full flex items-center justify-center" style="background-color:rgba(13,148,136,0.15);color:#0D9488;font-size:10px;">✓</span>${text}</li>`;
  }

  function getOrderedSpecs(product: {
    name: string;
    sizes: string;
    description?: string;
    features?: string[];
    specifications?: { key: string; value: string }[];
  }) {
    const order = ['Product Type', 'Design', 'Support Area', 'Special Features', 'Material', 'Sizes Available'];
    const sourceSpecs = product.specifications ?? [];
    const allLabels = [...order, 'Application', 'Usage', 'Closure', 'Compression', 'Fastening System', 'Sole Type', 'Use'];
    const sourceText = sourceSpecs
      .map(spec => `${spec.key} ${spec.value}`)
      .join(' ')
      .replace(/\s+/g, ' ')
      .trim();
    const ordered = new Map<string, string>();

    const escapePattern = (text: string) => text.replace(/\s+/g, '\\s+');
    const hasEmbeddedLabels = (text: string) =>
      allLabels.some(label => new RegExp(`\\b${escapePattern(label)}\\b`, 'i').test(text));

    function extract(label: string) {
      if (!sourceText) return '';
      const nextLabels = allLabels.filter(item => item !== label).map(escapePattern).join('|');
      const match = sourceText.match(new RegExp(`\\b${escapePattern(label)}\\b\\s+(.+?)(?=\\s+(?:${nextLabels})\\b|$)`, 'i'));
      return match?.[1]?.trim().replace(/[.;,]\s*$/, '') ?? '';
    }

    function inferSupportArea() {
      const text = `${product.name} ${product.description ?? ''}`.toLowerCase();
      if (text.includes('cervical') || text.includes('neck')) return 'Neck and cervical region';
      if (text.includes('shoulder') || text.includes('clavicle') || text.includes('arm sling')) return 'Shoulder and arm region';
      if (text.includes('elbow')) return 'Elbow joint';
      if (text.includes('wrist') || text.includes('forearm') || text.includes('thumb')) return 'Wrist, forearm, and thumb region';
      if (text.includes('finger')) return 'Finger joint';
      if (text.includes('chest') || text.includes('rib')) return 'Chest and rib cage';
      if (text.includes('lumbar') || text.includes('back') || text.includes('spine') || text.includes('sacral')) return 'Back and lumbosacral region';
      if (text.includes('abdomen') || text.includes('abdominal')) return 'Abdominal region';
      if (text.includes('pelvic') || text.includes('pelvis')) return 'Pelvic region';
      if (text.includes('knee') || text.includes('patella')) return 'Knee joint';
      if (text.includes('calf') || text.includes('stocking')) return 'Calf and leg region';
      if (text.includes('ankle') || text.includes('foot drop')) return 'Ankle joint';
      if (text.includes('foot') || text.includes('heel') || text.includes('arch') || text.includes('toe')) return 'Foot region';
      return 'Targeted orthopedic support area';
    }

    function inferMaterial() {
      const description = product.description ?? '';
      const materialMatch = description.match(/\b(?:made|manufactured|built)\s+(?:from|with|using)\s+(.+?)(?:,|\.\s| for | to )/i);
      if (materialMatch?.[1]) return materialMatch[1].trim();
      const featureMatch = product.features?.find(item => /material|fabric|foam|elastic|silicone|aluminum|metal|cotton|breathable|durable/i.test(item));
      return featureMatch ?? 'Comfortable and durable orthopedic support material';
    }

    function toSentenceCase(text: string) {
      const trimmed = text.trim();
      return trimmed ? `${trimmed.charAt(0).toUpperCase()}${trimmed.slice(1)}` : trimmed;
    }

    function inferDesign() {
      const text = `${product.name} ${product.description ?? ''}`;
      const designMatch = text.match(/(?:features|with|designed with|has)\s+(?:an?\s+)?(.+?(?:design|construction|wrap pattern|support system|closure|brace|belt|splint|cushion|insole|walker|stick))/i);
      if (designMatch?.[1]) return designMatch[1].trim().replace(/[.;,]\s*$/, '');
      return `${product.name} support design`;
    }

    function inferSpec(label: string) {
      if (label === 'Product Type') return product.name;
      if (label === 'Design') return inferDesign();
      if (label === 'Support Area') return inferSupportArea();
      if (label === 'Special Features') return product.features?.slice(0, 3).join(', ') || 'Supportive orthopedic design for daily and rehabilitation use';
      if (label === 'Material') return toSentenceCase(inferMaterial());
      if (label === 'Sizes Available') return product.sizes;
      return '';
    }

    for (const spec of sourceSpecs) {
      const key = spec.key.trim();
      const value = spec.value.trim();
      if (!order.includes(key) || !value || hasEmbeddedLabels(value)) continue;
      ordered.set(key, value);
    }

    for (const label of order) {
      if (label === 'Sizes Available') {
        ordered.set(label, product.sizes);
        continue;
      }

      if (!ordered.has(label)) {
        const extracted = extract(label);
        ordered.set(label, extracted || inferSpec(label));
      }
    }

    return order
      .map(label => ({ key: label, value: ordered.get(label) as string }));
  }

  function openModal(product: {
    sku: string; name: string; sizes: string;
    shortDescription?: string; description?: string;
    features?: string[]; benefits?: string[];
    recommendedUse?: string[];
    specifications?: { key: string; value: string }[];
    faqs?: { q: string; a: string }[];
  }, slug: string, base: string) {

    (document.getElementById('modal-image') as HTMLImageElement).src = `${base}images/products/${slug}/${product.sku}.png`;
    (document.getElementById('modal-image') as HTMLImageElement).alt = product.name;
    (document.getElementById('modal-name') as HTMLElement).textContent = product.name;
    (document.getElementById('modal-sku') as HTMLElement).textContent = product.sku;
    (document.getElementById('modal-sizes') as HTMLElement).textContent = `Available sizes: ${product.sizes}`;
    (document.getElementById('modal-enquire') as HTMLAnchorElement).href = `${base}contact/?product=${encodeURIComponent(product.name)}`;

    // Short description
    const shortDesc = document.getElementById('modal-short-desc') as HTMLElement;
    shortDesc.textContent = product.shortDescription || '';
    show('modal-short-desc', !!product.shortDescription);

    // Full description (split on \n\n into paragraphs)
    const descSection = document.getElementById('modal-desc-section') as HTMLElement;
    const descEl = document.getElementById('modal-desc') as HTMLElement;
    if (product.description) {
      descEl.innerHTML = product.description.split('\n\n').map(p => `<p>${p}</p>`).join('');
      descSection.style.display = '';
    } else {
      descSection.style.display = 'none';
    }

    // Features
    const featuresList = document.getElementById('modal-features') as HTMLElement;
    const features = product.features?.filter(item => item.trim()) ?? [];
    if (features.length) {
      featuresList.innerHTML = features.map(checkItem).join('');
      show('modal-features-section', true);
    } else {
      show('modal-features-section', false);
    }

    // Benefits
    const benefitsList = document.getElementById('modal-benefits') as HTMLElement;
    const benefits = product.benefits?.filter(item => item.trim()) ?? [];
    if (benefits.length) {
      benefitsList.innerHTML = benefits.map(checkItem).join('');
      show('modal-benefits-section', true);
    } else {
      show('modal-benefits-section', false);
    }

    // Recommended Use
    const recEl = document.getElementById('modal-rec') as HTMLElement;
    const recommendedUse = product.recommendedUse?.filter(item => item.trim()) ?? [];
    if (recommendedUse.length) {
      recEl.innerHTML = recommendedUse.map(u =>
        `<span style="display:inline-block;background:#f0fafa;border:1px solid #b2dfdb;color:#0D9488;border-radius:20px;padding:3px 12px;font-size:12px;">${u}</span>`
      ).join('');
      show('modal-rec-section', true);
    } else {
      show('modal-rec-section', false);
    }

    // Specifications
    const specsEl = document.getElementById('modal-specs') as HTMLElement;
    const orderedSpecs = getOrderedSpecs(product);
    if (orderedSpecs.length) {
      specsEl.innerHTML = orderedSpecs.map(s =>
        `<div style="display:flex;gap:12px;font-size:13px;padding:6px 0;border-bottom:1px solid #f0f0f0;">
          <span style="color:#6b7280;width:130px;flex-shrink:0;">${s.key}</span>
          <span style="color:#111827;font-weight:500;">${s.value}</span>
        </div>`
      ).join('');
      show('modal-specs-section', true);
    } else {
      show('modal-specs-section', false);
    }

    // FAQs
    const faqsEl = document.getElementById('modal-faqs') as HTMLElement;
    if (product.faqs && product.faqs.length) {
      faqsEl.innerHTML = product.faqs.map(f =>
        `<div>
          <p style="font-weight:600;color:#0F1F54;margin-bottom:4px;">Q. ${f.q}</p>
          <p style="color:#4b5563;font-size:14px;">${f.a}</p>
        </div>`
      ).join('');
      show('modal-faqs-section', true);
    } else {
      show('modal-faqs-section', false);
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.product-card').forEach(card => {
    card.addEventListener('click', () => {
      const product = JSON.parse((card as HTMLElement).dataset.product || '{}');
      const slug = (card as HTMLElement).dataset.slug || '';
      const base = (card as HTMLElement).dataset.base || '/';
      openModal(product, slug, base);
    });
  });

  modalClose?.addEventListener('click', closeModal);
  modal?.addEventListener('click', e => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  // Auto-open product from search — check sessionStorage first, fall back to URL hash
  function tryOpenProduct(sku: string) {
    const target = document.querySelector(`[data-sku="${sku.toUpperCase()}"]`) as HTMLElement | null;
    if (target) {
      const product = JSON.parse((target as HTMLElement).dataset.product || '{}');
      const slug = (target as HTMLElement).dataset.slug || '';
      const base = (target as HTMLElement).dataset.base || '/';
      openModal(product, slug, base);
    }
  }

  const urlSku = new URLSearchParams(location.search).get('sku');
  if (urlSku) tryOpenProduct(urlSku);
</script>
