---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const svg = (inner: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;

const categories = [
  { slug: 'neck-aids',           title: 'Neck Aids',                   desc: 'Cervical collars and support braces',             count: 4,  icon: svg(`<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/>`) },
  { slug: 'shoulder-aids',       title: 'Shoulder Aids',               desc: 'Arm slings, immobilizers, supports',              count: 7,  icon: svg(`<path d="M3 7h18"/><path d="M3 7l9 13 9-13"/>`) },
  { slug: 'forearm-wrist-aids',  title: 'Forearm & Wrist Aids',        desc: 'Elbow supports, wrist splints and braces',        count: 5,  icon: svg(`<rect x="3" y="8" width="18" height="9" rx="4.5"/><line x1="3" y1="12.5" x2="21" y2="12.5"/>`) },
  { slug: 'finger-aids',         title: 'Finger Aids',                 desc: 'Finger splints, cots, thumb supports',            count: 5,  icon: svg(`<rect x="9" y="3" width="6" height="18" rx="3"/><line x1="9" y1="10" x2="15" y2="10"/><line x1="9" y1="15" x2="15" y2="15"/>`) },
  { slug: 'chest-rib-back-aids', title: 'Chest, Rib & Back Aids',      desc: 'Lumbar belts, rib braces, chest binders',        count: 6,  icon: svg(`<line x1="12" y1="2" x2="12" y2="22"/><path d="M12 7c-2 1-4 1-5.5.5"/><path d="M12 12c-2.5 1.5-5 1.5-7 .5"/><path d="M12 17c-2.5 1-5 .5-6.5-.5"/><path d="M12 7c2 1 4 1 5.5.5"/><path d="M12 12c2.5 1.5 5 1.5 7 .5"/><path d="M12 17c2.5 1 5 .5 6.5-.5"/>`) },
  { slug: 'abdomen-pelvic-aids', title: 'Abdomen & Pelvic Aids',       desc: 'Abdominal belts, maternity and hernia supports', count: 4,  icon: svg(`<rect x="2" y="9" width="20" height="6" rx="2"/><line x1="9" y1="9" x2="9" y2="15"/><line x1="15" y1="9" x2="15" y2="15"/><line x1="9" y1="12" x2="15" y2="12"/>`) },
  { slug: 'knee-calf-aids',      title: 'Knee & Calf Aids',            desc: 'Knee caps, ROM braces, varicose stockings',      count: 9,  icon: svg(`<line x1="14" y1="3" x2="14" y2="10.5"/><path d="M14 10.5q-2 3-4 3.5"/><line x1="10" y1="14" x2="10" y2="21"/><circle cx="12" cy="13" r="3"/>`) },
  { slug: 'ankle-aids',          title: 'Ankle Aids',                  desc: 'Ankle supports, foot drop splints, cast shoes',  count: 6,  icon: svg(`<path d="M9 4v13q0 3 3 3h7"/>`) },
  { slug: 'foot-aids',           title: 'Foot Aids',                   desc: 'Gel insoles, heel cushions, arch supports',      count: 4,  icon: svg(`<path d="M7 11c-1.5 4-1 9 2 11h7c3.5-1.5 4.5-6.5 3-10C18 8 14.5 5 11 5 8.5 5 8.5 8 7 11z"/><line x1="7" y1="18" x2="19" y2="18"/>`) },
  { slug: 'traction-comfort',    title: 'Traction Kit & Comfort Aids', desc: 'Traction kits, cervical pillows, cushions',      count: 6,  icon: svg(`<ellipse cx="12" cy="12" rx="10" ry="5.5"/><path d="M2 12q5-3 10-3t10 3"/>`) },
  { slug: 'walking-aids',        title: 'Walking Aids',                desc: 'Walking sticks, walkers, folding walkers',       count: 4,  icon: svg(`<circle cx="15" cy="5" r="2"/><line x1="14" y1="7" x2="7" y2="21"/>`) },
];
---

<BaseLayout title="Products" description="Browse Ikvion's full range of orthopedic soft goods and rehabilitation aids across 11 categories.">

  <!-- Page Header -->
  <div style="background-color: #0F1F54;" class="py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <nav class="text-sm text-gray-400 mb-3">
        <a href={`${base}`} class="hover:text-[#0D9488]">Home</a>
        <span class="mx-2">/</span>
        <span class="text-white">Products</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Playfair Display', serif;">
        Product Catalogue
      </h1>
      <p class="text-gray-300 mt-2">60+ products across 11 categories</p>
    </div>
  </div>

  <!-- Categories Grid -->
  <section class="py-12 px-4 sm:px-6 lg:px-8" style="background-color: #FFFFFF;">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map(cat => (
          <a
            href={`${base}products/${cat.slug}/`}
            class="group bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all hover:-translate-y-0.5"
          >
            <div class="p-6">
              <div class="flex items-start justify-between mb-4">
                <div class="w-12 h-12 rounded-lg flex items-center justify-center text-[#0D9488]" style="background-color: rgba(13,148,136,0.1);">
                  <Fragment set:html={cat.icon} />
                </div>
                <span class="text-xs font-medium px-2 py-1 rounded-full text-white" style="background-color: #0D9488;">
                  {cat.count} products
                </span>
              </div>
              <h2 class="text-lg font-semibold mb-1 group-hover:text-[#0D9488] transition-colors" style="color: #0F1F54;">
                {cat.title}
              </h2>
              <p class="text-sm text-gray-500 mb-4">{cat.desc}</p>
              <span class="inline-flex items-center gap-1 text-sm font-medium text-[#0D9488]">
                View products
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-white py-12 px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl font-bold mb-3" style="color: #0F1F54;">Need a custom quote or full catalogue?</h2>
    <p class="text-gray-600 mb-6">Contact us for pricing, MOQ details, and export documentation.</p>
    <a
      href={`${base}contact/`}
      class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white hover:opacity-90 transition-opacity"
      style="background-color: #0F1F54;"
    >
      Get in Touch
    </a>
  </section>

</BaseLayout>
