---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const categories = [
  { slug: 'neck-aids',           title: 'Cervical Collars',            count: 4,  image: 'images/category-neck-aids.jpeg' },
  { slug: 'shoulder-aids',       title: 'Shoulder Aids',               count: 7,  image: 'images/category-shoulder-aids.png' },
  { slug: 'forearm-wrist-aids',  title: 'Forearm & Wrist Aids',        count: 5,  image: 'images/category-forearm-wrist-aids.png' },
  { slug: 'finger-aids',         title: 'Finger Aids',                 count: 5,  image: 'images/category-finger-aids.jpg' },
  { slug: 'chest-rib-back-aids', title: 'Chest, Rib & Back Aids',      count: 6,  image: 'images/category-chest-rib-back-aids.jpg' },
  { slug: 'abdomen-pelvic-aids', title: 'Abdomen & Pelvic Aids',       count: 4,  image: 'images/category-abdomen-pelvic-aids.jpg' },
  { slug: 'knee-calf-aids',      title: 'Knee & Calf Aids',            count: 9,  image: 'images/category-knee-calf-aids.jpg' },
  { slug: 'ankle-aids',          title: 'Ankle Aids',                  count: 6,  image: 'images/category-ankle-aids.jpg' },
  { slug: 'foot-aids',           title: 'Foot Aids',                   count: 4,  image: 'images/category-foot-aids.jpg' },
  { slug: 'traction-comfort',    title: 'Traction Kit & Comfort Aids', count: 6,  image: 'images/category-traction-comfort.jpg' },
  { slug: 'walking-aids',        title: 'Walking Aids',                count: 4,  image: 'images/category-walking-aids.jpg' },
];
---

<BaseLayout title="Products" description="Browse Ikvion's full range of orthopedic soft goods and rehabilitation aids across 11 categories.">

  <!-- Page Header -->
  <div style="background-color: #0F1F54;" class="py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <nav class="text-sm text-gray-400 mb-3">
        <a href={`${base}`} class="hover:text-[#0D9488]">Home</a>
        <span class="mx-2">/</span>
        <span class="text-white">Products</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Playfair Display', serif;">
        Product Catalogue
      </h1>
      <p class="text-gray-300 mt-2">60+ products across 11 categories</p>
      <a
        href={`${base}products/all/`}
        class="inline-flex items-center gap-2 mt-4 px-4 py-2 rounded-lg text-sm font-medium text-white border border-white/40 hover:bg-white/20 transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
        </svg>
        View All Products
      </a>
    </div>
  </div>

  <!-- Categories Grid -->
  <section class="py-12 px-4 sm:px-6 lg:px-8" style="background-color: #FFFFFF;">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {categories.map(cat => (
          <a
            href={`${base}products/${cat.slug}/`}
            class="group bg-white rounded-xl p-4 shadow-sm hover:shadow-md transition-all hover:-translate-y-0.5 border border-transparent hover:border-[#0D9488]/30 flex items-center gap-3"
          >
            <img
              src={`${base}${cat.image}`}
              alt=""
              class="w-32 h-32 rounded-xl object-cover bg-[#F0FDFA] shrink-0"
              loading="lazy"
            />
            <div class="min-w-0 flex-1">
              <h3 class="font-semibold text-[#0F1F54] mb-1 group-hover:text-[#0D9488] transition-colors text-lg leading-tight">
                {cat.title}
              </h3>
              <p class="text-sm text-gray-400">{cat.count} products</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-white py-12 px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-2xl font-bold mb-3" style="color: #0F1F54;">Need a custom quote or full catalogue?</h2>
    <p class="text-gray-600 mb-6">Contact us for pricing, MOQ details, and export documentation.</p>
    <a
      href={`${base}contact/`}
      class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white hover:opacity-90 transition-opacity"
      style="background-color: #0F1F54;"
    >
      Get in Touch
    </a>
  </section>

</BaseLayout>
