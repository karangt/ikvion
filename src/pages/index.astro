---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const categories = [
  { slug: 'neck-aids',          title: 'Neck Aids',                    icon: '🦴', count: 4  },
  { slug: 'shoulder-aids',      title: 'Shoulder Aids',                icon: '💪', count: 7  },
  { slug: 'forearm-wrist-aids', title: 'Forearm & Wrist Aids',         icon: '🤝', count: 5  },
  { slug: 'finger-aids',        title: 'Finger Aids',                  icon: '👆', count: 5  },
  { slug: 'chest-rib-back-aids',title: 'Chest, Rib & Back Aids',       icon: '🫀', count: 6  },
  { slug: 'abdomen-pelvic-aids',title: 'Abdomen & Pelvic Aids',        icon: '🩺', count: 4  },
  { slug: 'knee-calf-aids',     title: 'Knee & Calf Aids',             icon: '🦵', count: 9  },
  { slug: 'ankle-aids',         title: 'Ankle Aids',                   icon: '🦶', count: 6  },
  { slug: 'foot-aids',          title: 'Foot Aids',                    icon: '👣', count: 4  },
  { slug: 'traction-comfort',   title: 'Traction Kit & Comfort Aids',  icon: '🛏️', count: 6  },
  { slug: 'walking-aids',       title: 'Walking Aids',                 icon: '🚶', count: 4  },
];

const certifications = ['ISO 9001:2008', 'MSME Registered', 'WHO GMP Certified', 'CE Marked'];
---

<BaseLayout title="Home" description="Ikvion Group of Companies — Orthopedic Soft Goods & Rehabilitation Aids exporter. Supporting Better Mobility.">

  <!-- Hero -->
  <section style="background-color: #1B2A4A;" class="relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <svg viewBox="0 0 800 600" class="w-full h-full" preserveAspectRatio="xMidYMid slice">
        <circle cx="700" cy="100" r="300" fill="#4ABFBF" />
        <circle cx="100" cy="500" r="200" fill="#C9A08A" />
      </svg>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-widest mb-4" style="color: #4ABFBF;">
          Ikvion Group of Companies
        </p>
        <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight mb-6" style="font-family: 'Playfair Display', serif;">
          Supporting<br />
          <span style="color: #C9A08A;">Better Mobility</span>
        </h1>
        <p class="text-lg text-gray-300 mb-8 leading-relaxed">
          Premium Orthopedic Soft Goods &amp; Rehabilitation Aids — manufactured and exported from Pune, India. Trusted by healthcare providers worldwide.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href={`${base}products/`}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-[#1B2A4A] hover:opacity-90 transition-opacity"
            style="background-color: #4ABFBF;"
          >
            View Products
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href={`${base}contact/`}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white border border-white/30 hover:border-white/60 transition-colors"
          >
            Enquire Now
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications bar -->
  <div style="background-color: #C9A08A;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2">
        {certifications.map(cert => (
          <span class="flex items-center gap-2 text-sm font-medium text-white">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            {cert}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Stats -->
  <section class="bg-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[
          { value: '60+', label: 'Products' },
          { value: '11', label: 'Categories' },
          { value: '20+', label: 'Countries Served' },
          { value: '4', label: 'Certifications' },
        ].map(stat => (
          <div>
            <div class="text-4xl font-bold mb-1" style="color: #1B2A4A; font-family: 'Playfair Display', serif;">
              {stat.value}
            </div>
            <div class="text-sm text-gray-500">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Categories -->
  <section class="py-16 px-4 sm:px-6 lg:px-8" style="background-color: #F5F0EB;">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: #1B2A4A; font-family: 'Playfair Display', serif;">
          Product Categories
        </h2>
        <p class="text-gray-600 max-w-xl mx-auto">
          Comprehensive range of orthopedic soft goods covering every major body region — from neck to foot.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {categories.map(cat => (
          <a
            href={`${base}products/${cat.slug}/`}
            class="group bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all hover:-translate-y-0.5 border border-transparent hover:border-[#4ABFBF]/30"
          >
            <div class="text-3xl mb-3">{cat.icon}</div>
            <h3 class="font-semibold text-[#1B2A4A] mb-1 group-hover:text-[#4ABFBF] transition-colors">
              {cat.title}
            </h3>
            <p class="text-sm text-gray-500">{cat.count} products</p>
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a
          href={`${base}products/`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white transition-opacity hover:opacity-90"
          style="background-color: #1B2A4A;"
        >
          View All Products
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Ikvion -->
  <section class="bg-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: #1B2A4A; font-family: 'Playfair Display', serif;">
          Why Choose Ikvion?
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            icon: '🏆',
            title: 'Certified Quality',
            desc: 'ISO 9001:2008, WHO GMP Certified, and CE Marked products ensuring international quality standards.'
          },
          {
            icon: '🌍',
            title: 'Global Export Expertise',
            desc: 'Experienced in exporting to over 20 countries, with seamless logistics and documentation support.'
          },
          {
            icon: '📦',
            title: 'Wide Product Range',
            desc: 'Over 60 products across 11 categories — a one-stop solution for all orthopedic soft goods needs.'
          },
        ].map(item => (
          <div class="text-center p-6 rounded-xl" style="background-color: #F5F0EB;">
            <div class="text-4xl mb-4">{item.icon}</div>
            <h3 class="text-lg font-semibold mb-2" style="color: #1B2A4A;">{item.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section style="background-color: #4ABFBF;" class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4" style="font-family: 'Playfair Display', serif;">
        Looking for a Reliable Export Partner?
      </h2>
      <p class="text-white/80 mb-8 text-lg">
        Get in touch with our team for product catalogues, pricing, and export enquiries.
      </p>
      <a
        href={`${base}contact/`}
        class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold transition-opacity hover:opacity-90"
        style="background-color: #1B2A4A; color: white;"
      >
        Contact Us Today
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

</BaseLayout>
