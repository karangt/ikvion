---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const svg = (inner: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;

const categories = [
  { slug: 'neck-aids',          title: 'Cervical Collars',             count: 4,  image: 'images/category-neck-aids.jpeg', featured: true },
  { slug: 'shoulder-aids',      title: 'Shoulder Aids',                count: 7,  image: 'images/category-shoulder-aids.png', featured: true },
  { slug: 'forearm-wrist-aids', title: 'Forearm & Wrist Aids',         count: 5,  image: 'images/category-forearm-wrist-aids.png', featured: true },
  { slug: 'finger-aids',        title: 'Finger Aids',                  count: 5,  image: 'images/category-finger-aids.jpg', featured: true },
  { slug: 'chest-rib-back-aids',title: 'Chest, Rib & Back Aids',       count: 6,  image: 'images/category-chest-rib-back-aids.jpg', featured: true },
  { slug: 'abdomen-pelvic-aids',title: 'Abdomen & Pelvic Aids',        count: 4,  image: 'images/category-abdomen-pelvic-aids.jpg', featured: true },
  { slug: 'knee-calf-aids',     title: 'Knee & Calf Aids',             count: 9,  image: 'images/category-knee-calf-aids.jpg', featured: true },
  { slug: 'ankle-aids',         title: 'Ankle Aids',                   count: 7,  image: 'images/category-ankle-aids.jpg', featured: true },
  { slug: 'foot-aids',          title: 'Foot Aids',                    count: 4,  image: 'images/category-foot-aids.jpg', featured: true },
  { slug: 'traction-comfort',   title: 'Traction Kit & Comfort Aids',  count: 6,  image: 'images/category-traction-comfort.jpg', featured: true },
  { slug: 'walking-aids',       title: 'Walking Aids',                 count: 4,  image: 'images/category-walking-aids.jpg', featured: true },
];

const certifications = ['ISO 9001:2008', 'MSME Registered', 'WHO GMP Certified', 'CE Marked'];
---

<BaseLayout
  fullTitle="Ikvion | Orthopedic Soft Goods & Rehabilitation Aids Exporter — Pune, India"
  description="Ikvion Group of Companies — ISO-certified manufacturer and exporter of orthopedic soft goods and rehabilitation aids from Pune, India. 60+ products across 11 categories including cervical collars, knee braces, arm slings, and walking aids. Trusted by healthcare providers in 10+ countries."
>

  <!-- Hero -->
  <section style="background-color: #0F1F54;" class="relative overflow-hidden">
    <picture>
      <source media="(max-width: 767px)" srcset={`${base}images/hero-supporting-mobility-mobile.png`} />
      <img
        src={`${base}images/hero-supporting-mobility-headroom.png`}
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-center"
        style="object-position: center bottom;"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <div
      class="absolute inset-0"
      style="background: linear-gradient(90deg, rgba(15,31,84,0.94) 0%, rgba(15,31,84,0.88) 34%, rgba(15,31,84,0.46) 64%, rgba(15,31,84,0.16) 100%);"
    ></div>
    <div
      class="absolute inset-0 opacity-20"
      style="background: linear-gradient(180deg, rgba(15,31,84,0.24), rgba(15,31,84,0.62));"
    ></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-24 sm:pb-24 md:py-32">
      <div class="max-w-2xl">
        <p class="text-xs sm:text-sm font-semibold uppercase tracking-widest mb-4" style="color: #0D9488;">
          Ikvion Group of Companies
        </p>
        <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight mb-5 sm:mb-6" style="font-family: 'Playfair Display', serif;">
          Supporting<br />
          <span style="color: #D7AA9F;">Better Mobility</span>
        </h1>
        <p class="text-base sm:text-lg text-gray-300 mb-6 sm:mb-8 leading-relaxed">
          Premium Orthopedic Soft Goods &amp; Rehabilitation Aids — manufactured and exported from Pune, India. Trusted by healthcare providers worldwide.
        </p>
        <div class="grid grid-cols-1 gap-3 sm:flex sm:flex-wrap sm:gap-4">
          <a
            href={`${base}products/`}
            class="inline-flex items-center justify-center gap-2 px-5 py-3 sm:px-6 rounded-lg font-semibold text-[#0F1F54] hover:opacity-90 transition-opacity"
            style="background-color: #0D9488;"
          >
            View Products
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a
            href={`${base}contact/`}
            class="inline-flex items-center justify-center gap-2 px-5 py-3 sm:px-6 rounded-lg font-semibold text-white border border-white/30 hover:border-white/60 transition-colors"
          >
            Enquire Now
          </a>
          <a
            href={`${base}Ikvion_Brochure.pdf`}
            download="Ikvion_Brochure.pdf"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 sm:px-6 rounded-lg font-semibold text-white border border-white/30 hover:border-white/60 transition-colors"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16v-8m0 8l-3-3m3 3l3-3M4 20h16" />
            </svg>
            Download Brochure
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications bar -->
  <div style="background-color: #D7AA9F;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2">
        {certifications.map(cert => (
          <span class="flex items-center gap-2 text-sm font-medium text-white">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            {cert}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- Stats -->
  <section class="bg-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        {[
          { value: '60+', label: 'Products' },
          { value: '11', label: 'Categories' },
          { value: '10+', label: 'Countries Served' },
          { value: '4', label: 'Certifications' },
        ].map(stat => (
          <div>
            <div class="text-4xl font-bold mb-1" style="color: #0F1F54; font-family: 'Playfair Display', serif;">
              {stat.value}
            </div>
            <div class="text-sm text-gray-500">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Categories -->
  <section class="py-16 px-4 sm:px-6 lg:px-8" style="background-color: #FFFFFF;">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: #0F1F54; font-family: 'Playfair Display', serif;">
          Product Categories
        </h2>
        <p class="text-gray-600 max-w-xl mx-auto">
          Comprehensive range of orthopedic soft goods covering every major body region — from neck to foot.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {categories.map(cat => (
          <a
            href={`${base}products/${cat.slug}/`}
            class:list={[
              'group bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-all hover:-translate-y-0.5 border border-transparent hover:border-[#0D9488]/30',
              cat.featured ? 'flex items-center gap-3 p-4' : ''
            ]}
          >
            {cat.image ? (
              <img
                src={`${base}${cat.image}`}
                alt=""
                class:list={[
                  'rounded-xl object-cover bg-[#F0FDFA]',
                  cat.featured
                    ? 'w-32 h-32 shrink-0'
                    : 'w-16 h-16 mb-3'
                ]}
                loading="lazy"
              />
            ) : (
              <>
                <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-3 text-[#0D9488]" style="background-color: rgba(13,148,136,0.1);">
                  <Fragment set:html={cat.icon} />
                </div>
              </>
            )}
            <div class:list={[cat.featured ? 'min-w-0 flex-1' : '']}>
              <h3
                class:list={[
                  'font-semibold text-[#0F1F54] mb-1 group-hover:text-[#0D9488] transition-colors',
                  cat.featured ? 'text-lg leading-tight' : ''
                ]}
              >
                {cat.title}
              </h3>
              <p class:list={[cat.featured ? 'text-sm text-gray-400' : 'text-sm text-gray-500']}>
                {cat.count} products
              </p>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a
          href={`${base}products/all/`}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-white transition-opacity hover:opacity-90"
          style="background-color: #0F1F54;"
        >
          View All Products
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Why Choose Ikvion -->
  <section class="bg-white py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: #0F1F54; font-family: 'Playfair Display', serif;">
          Why Choose Ikvion?
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          {
            icon: svg(`<path d="M6 9H4.5a2.5 2.5 0 010-5H6"/><path d="M18 9h1.5a2.5 2.5 0 000-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0012 0V2z"/>`),
            title: 'Certified Quality',
            desc: 'ISO 9001:2008, WHO GMP Certified, and CE Marked products ensuring international quality standards.'
          },
          {
            icon: svg(`<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>`),
            title: 'Dedicated Support',
            desc: 'Every partner gets a dedicated account manager for enquiries, orders, and after-sales support.'
          },
          {
            icon: svg(`<path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>`),
            title: 'Wide Product Range',
            desc: 'Over 60 products across 11 categories — a one-stop solution for all orthopedic soft goods needs.'
          },
        ].map(item => (
          <div class="text-center p-6 rounded-xl" style="background-color: #FFFFFF;">
            <div class="w-14 h-14 rounded-xl flex items-center justify-center mx-auto mb-4 text-[#0D9488]" style="background-color: rgba(13,148,136,0.1);">
              <Fragment set:html={item.icon} />
            </div>
            <h3 class="text-lg font-semibold mb-2" style="color: #0F1F54;">{item.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section style="background-color: #0D9488;" class="py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4" style="font-family: 'Playfair Display', serif;">
        Looking for a Reliable Export Partner?
      </h2>
      <p class="text-white/80 mb-8 text-lg">
        Get in touch with our team for product catalogues, pricing, and export enquiries.
      </p>
      <a
        href={`${base}contact/`}
        class="inline-flex items-center gap-2 px-8 py-4 rounded-lg font-semibold transition-opacity hover:opacity-90"
        style="background-color: #0F1F54; color: white;"
      >
        Contact Us Today
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

</BaseLayout>
