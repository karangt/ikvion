---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;

const placeholderTestimonials = [
  {
    name: 'Dr. Ahmed Al-Rashid',
    role: 'Orthopaedic Surgeon',
    country: 'UAE',
    flag: '🇦🇪',
    quote: 'Ikvion\'s cervical collars and lumbar supports have become a staple in our rehabilitation unit. Consistent quality, good packaging, and reliable delivery every time.'
  },
  {
    name: 'Sarah Mitchell',
    role: 'Medical Supplies Distributor',
    country: 'United Kingdom',
    flag: '🇬🇧',
    quote: 'We\'ve been sourcing orthopedic soft goods from Ikvion for over three years. Their product range is comprehensive and the export documentation is always flawless.'
  },
  {
    name: 'Dr. Priya Nair',
    role: 'Physiotherapist',
    country: 'India',
    flag: '🇮🇳',
    quote: 'My patients frequently compliment the comfort and fit of Ikvion braces. The WHO GMP certification gives us confidence in recommending these products.'
  },
  {
    name: 'Thomas Müller',
    role: 'Healthcare Procurement Manager',
    country: 'Germany',
    flag: '🇩🇪',
    quote: 'CE marked products, competitive pricing, and a dedicated account manager who actually responds. Ikvion has been a reliable partner for our procurement team.'
  },
  {
    name: 'Fatima Al-Zahra',
    role: 'Hospital Supply Chain Manager',
    country: 'Saudi Arabia',
    flag: '🇸🇦',
    quote: 'The range of knee and ankle aids from Ikvion has significantly improved our rehabilitation department\'s inventory. Quality and value are both excellent.'
  },
  {
    name: 'James Okonkwo',
    role: 'Medical Equipment Distributor',
    country: 'Nigeria',
    flag: '🇳🇬',
    quote: 'Ikvion made the import process straightforward. All documentation was prepared correctly from the first order, and the products sell themselves on quality.'
  },
];
---

<BaseLayout title="Testimonials" description="Read what healthcare providers, distributors, and medical professionals worldwide say about Ikvion orthopedic products.">

  <!-- Header -->
  <div style="background-color: #0F1F54;" class="py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <nav class="text-sm text-gray-400 mb-3">
        <a href={`${base}`} class="hover:text-[#0D9488]">Home</a>
        <span class="mx-2">/</span>
        <a href={`${base}about/`} class="hover:text-[#0D9488]">About</a>
        <span class="mx-2">/</span>
        <span class="text-white">Testimonials</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Playfair Display', serif;">
        What Our Partners Say
      </h1>
      <p class="text-gray-300 mt-2">Real feedback from healthcare providers and distributors across the globe.</p>
    </div>
  </div>

  <!-- Testimonials Grid -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {placeholderTestimonials.map(t => (
          <div class="flex flex-col p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <!-- Quote mark -->
            <div class="text-4xl font-serif leading-none mb-4" style="color: #0D9488;">"</div>
            <p class="text-gray-600 text-sm leading-relaxed flex-1 mb-6">{t.quote}</p>
            <div class="flex items-center gap-3 pt-4 border-t border-gray-100">
              <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm shrink-0" style="background-color: #0F1F54;">
                {t.name.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}
              </div>
              <div>
                <div class="font-semibold text-sm" style="color: #0F1F54;">{t.name}</div>
                <div class="text-xs text-gray-500">{t.role} · {t.flag} {t.country}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Share Your Story CTA -->
  <section class="py-14 px-4 sm:px-6 lg:px-8" style="background-color: #D7AA9F;">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-white mb-3" style="font-family: 'Playfair Display', serif;">
        A satisfied Ikvion customer?
      </h2>
      <p class="text-white/90 mb-7 text-sm leading-relaxed">
        We'd love to hear your experience. Share your story and help other healthcare professionals discover the Ikvion difference.
      </p>
      <a href={`${base}contact/`} class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-[#D7AA9F] bg-white hover:opacity-90 transition-opacity">
        Share Your Feedback
      </a>
    </div>
  </section>

</BaseLayout>
