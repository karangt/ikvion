---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const web3FormsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const isFormConfigured = Boolean(web3FormsAccessKey);

const productCatalogue = [
  { category: 'Neck Aids', products: ['Cervical Collar With Support', 'Philadelphia Collar', 'Hard Cervical Collar', 'Soft Cervical Collar'] },
  { category: 'Shoulder Aids', products: ['Arm Sling', 'Arm Sling Tropical', 'Arm Sling Strap', 'Shoulder Support', 'Shoulder Immobilizer', 'Elastic Shoulder Immobilizer', 'Clavical Brace Stockinette'] },
  { category: 'Forearm & Wrist Aids', products: ['Elbow Support', 'Tennis Elbow Support', 'Wrist Splint', 'Wrist Brace', 'Wrist Brace with Thumb'] },
  { category: 'Finger Aids', products: ['Finger Cot', 'Frog Splint', 'Finger Mallet', 'Splint Finger', 'Thumb Spica Splint'] },
  { category: 'Chest, Rib & Back Aids', products: ['Ash Brace', 'Rib Belt', 'Chest Binder', 'Contoured L S Belt', 'Lumbar Sacral Belt', 'Dorso Lumbar Brace'] },
  { category: 'Abdomen & Pelvic Aids', products: ['Abdomen Belt', 'Maternity Belt', 'Pelvic Belt', 'Hernia Belt'] },
  { category: 'Knee & Calf Aids', products: ['Knee Cap', 'Hinge Knee Cap', 'Polycentric Hinge Knee Cap', 'Elastic Knee Support', 'Knee Cap with Open Patella', 'ROM Knee Brace', 'Knee Immobilizer', 'Varicose Stocking Below Knee', 'Varicose Stocking Above Knee'] },
  { category: 'Ankle Aids', products: ['Ankle Support', 'Anklet With Binder', 'Ankle Brace', 'Foot Drop Splint', 'Cast Shoes', 'Derotation Brace'] },
  { category: 'Foot Aids', products: ['Silicon Gel Insole', 'Silicon Gel Heel Cushion', 'Arch Support', 'Toe Separator'] },
  { category: 'Traction Kit & Comfort Aids', products: ['Skin Traction Kit', 'Leg Traction Brace', 'Ankle Traction', 'Cervical Pillow', 'Coccyx Seat Cushion', 'Back Rest Cushion'] },
  { category: 'Walking Aids', products: ['Walking Stick Single Leg', 'Walking Stick Four Leg', 'Walker', 'Walker Folding'] },
];

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Ikvion Group of Companies',
  url: 'https://www.ikvion.com',
  email: 'info@ikvion.com',
  telephone: '+91-8097197772',
  description: 'ISO-certified manufacturer and exporter of orthopedic soft goods and rehabilitation aids.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Pune',
    addressRegion: 'Maharashtra',
    addressCountry: 'IN',
  },
  areaServed: 'Worldwide',
  hasCredential: ['ISO 9001:2008', 'WHO GMP', 'CE Marking', 'MSME'],
};
---

<BaseLayout
  title="Contact Us"
  description="Contact Ikvion Group of Companies for orthopedic product enquiries, export pricing, and catalogue requests. Based in Pune, India — serving healthcare providers worldwide."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

  <!-- Header -->
  <div style="background-color: #0F1F54;" class="py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
      <nav class="text-sm text-gray-400 mb-3">
        <a href={`${base}`} class="hover:text-[#0D9488]">Home</a>
        <span class="mx-2">/</span>
        <span class="text-white">Contact</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white" style="font-family: 'Playfair Display', serif;">
        Contact Us
      </h1>
      <p class="text-gray-300 mt-2">We'd love to hear from you. Send us an enquiry.</p>
    </div>
  </div>

  <section class="py-16 px-4 sm:px-6 lg:px-8" style="background-color: #FFFFFF;">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-10">

      <!-- Contact Details -->
      <div class="lg:col-span-1 space-y-6">
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <h2 class="text-xl font-semibold mb-5" style="color: #0F1F54;">Get In Touch</h2>
          <ul class="space-y-4">
            <li class="flex gap-3 items-start">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 mt-0.5" style="background-color: #0D9488;">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-medium text-gray-400 uppercase mb-0.5">Address</p>
                <p class="text-sm text-gray-700">Ikvion Group of Companies<br />Pune, Maharashtra, India</p>
              </div>
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 mt-0.5" style="background-color: #0D9488;">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-medium text-gray-400 uppercase mb-0.5">Phone</p>
                <a href="tel:+918097197772" class="text-sm text-gray-700 hover:text-[#0D9488] transition-colors">+91 8097197772</a><br />
                <a href="tel:+919225523334" class="text-sm text-gray-700 hover:text-[#0D9488] transition-colors">+91 9225523334</a>
              </div>
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 mt-0.5" style="background-color: #0D9488;">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                  <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-medium text-gray-400 uppercase mb-0.5">Email</p>
                <a href="mailto:info@ikvion.com" class="text-sm text-gray-700 hover:text-[#0D9488] transition-colors">info@ikvion.com</a>
              </div>
            </li>
            <li class="flex gap-3 items-start">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 mt-0.5" style="background-color: #0D9488;">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M4.083 9h1.946c.089-1.546.383-2.97.837-4.118A6.004 6.004 0 004.083 9zM10 2a8 8 0 100 16 8 8 0 000-16zm0 2c-.076 0-.232.032-.465.262-.238.234-.497.623-.737 1.182-.389.907-.673 2.142-.766 3.556h3.936c-.093-1.414-.377-2.649-.766-3.556-.24-.56-.5-.948-.737-1.182C10.232 4.032 10.076 4 10 4zm3.971 5c-.089-1.546-.383-2.97-.837-4.118A6.004 6.004 0 0115.917 9h-1.946zm-2.003 2H8.032c.093 1.414.377 2.649.766 3.556.24.56.5.948.737 1.182.233.23.389.262.465.262.076 0 .232-.032.465-.262.238-.234.498-.623.737-1.182.389-.907.673-2.142.766-3.556zm1.166 4.118c.454-1.147.748-2.572.837-4.118h1.946a6.004 6.004 0 01-2.783 4.118zm-6.268 0C6.412 13.97 6.118 12.546 6.03 11H4.083a6.004 6.004 0 002.783 4.118z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <p class="text-xs font-medium text-gray-400 uppercase mb-0.5">Website</p>
                <a href="https://www.ikvion.com" target="_blank" rel="noopener" class="text-sm text-gray-700 hover:text-[#0D9488] transition-colors">www.ikvion.com</a>
              </div>
            </li>
          </ul>
        </div>

        <!-- Certifications -->
        <div class="bg-white rounded-xl p-6 shadow-sm">
          <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400 mb-3">Certifications</h3>
          <div class="flex flex-wrap gap-2">
            {['ISO 9001:2008', 'MSME', 'WHO GMP', 'CE'].map(cert => (
              <span class="text-xs px-2 py-1 rounded-full text-white font-medium" style="background-color: #0F1F54;">
                {cert}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-xl p-8 shadow-sm">
          <h2 class="text-xl font-semibold mb-6" style="color: #0F1F54;">Send an Enquiry</h2>
          <form
            id="contact-form"
            action="https://api.web3forms.com/submit"
            method="POST"
            data-configured={isFormConfigured ? 'true' : 'false'}
            class="space-y-5"
          >
            <input type="hidden" name="access_key" value={web3FormsAccessKey} />
            <input type="hidden" id="email-subject" name="subject" value="New Enquiry from Ikvion Website" />
            <input type="hidden" name="from_name" value="Ikvion Website" />
            <!-- Honeypot spam protection -->
            <input type="checkbox" name="botcheck" class="hidden" style="display:none" />
            <!-- Product of Interest multi-select -->
            <div class="relative" id="product-select-wrapper">
              <label class="block text-sm font-medium text-gray-700 mb-1">Product of Interest</label>
              <!-- Trigger button -->
              <button
                type="button"
                id="product-dropdown-btn"
                class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm text-left flex items-center justify-between focus:outline-none"
                onfocus="this.style.boxShadow='0 0 0 2px #0D948840'; this.style.borderColor='#0D9488';"
                onblur="this.style.boxShadow=''; this.style.borderColor='#e5e7eb';"
              >
                <span id="product-dropdown-label" class="text-gray-400">Select products…</span>
                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <!-- Dropdown panel -->
              <div
                id="product-dropdown-panel"
                class="hidden absolute z-20 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg max-h-72 overflow-y-auto"
              >
                {productCatalogue.map(group => (
                  <div>
                    <div class="px-3 py-2 text-xs font-bold uppercase tracking-wider text-gray-400 sticky top-0 bg-gray-50 border-b border-gray-100">
                      {group.category}
                    </div>
                    {group.products.map(product => (
                      <label class="flex items-center gap-3 px-4 py-2 hover:bg-teal-50 cursor-pointer text-sm text-gray-700">
                        <input
                          type="checkbox"
                          class="product-checkbox accent-[#0D9488] w-4 h-4 shrink-0"
                          value={product}
                        />
                        {product}
                      </label>
                    ))}
                  </div>
                ))}
              </div>
              <!-- Hidden input carries the comma-separated value to Web3Forms -->
              <input type="hidden" id="product" name="product" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Full Name *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="John Smith"
                  class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:border-transparent"
                  style="--tw-ring-color: #0D9488;"
                  onfocus="this.style.boxShadow='0 0 0 2px #0D948840'; this.style.borderColor='#0D9488';"
                  onblur="this.style.boxShadow=''; this.style.borderColor='#e5e7eb';"
                />
              </div>
              <div>
                <label for="company" class="block text-sm font-medium text-gray-700 mb-1">Company / Organisation</label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  placeholder="ABC Medical Supplies"
                  class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none"
                  onfocus="this.style.boxShadow='0 0 0 2px #0D948840'; this.style.borderColor='#0D9488';"
                  onblur="this.style.boxShadow=''; this.style.borderColor='#e5e7eb';"
                />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email Address *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="john@example.com"
                  class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none"
                  onfocus="this.style.boxShadow='0 0 0 2px #0D948840'; this.style.borderColor='#0D9488';"
                  onblur="this.style.boxShadow=''; this.style.borderColor='#e5e7eb';"
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Contact Number</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="+1 555 000 0000"
                  class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none"
                  onfocus="this.style.boxShadow='0 0 0 2px #0D948840'; this.style.borderColor='#0D9488';"
                  onblur="this.style.boxShadow=''; this.style.borderColor='#e5e7eb';"
                />
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="country" class="block text-sm font-medium text-gray-700 mb-1">Country</label>
                <input
                  type="text"
                  id="country"
                  name="country"
                  placeholder="United States"
                  class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none"
                  onfocus="this.style.boxShadow='0 0 0 2px #0D948840'; this.style.borderColor='#0D9488';"
                  onblur="this.style.boxShadow=''; this.style.borderColor='#e5e7eb';"
                />
              </div>
            </div>
            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
              <input
                type="text"
                id="subject"
                name="enquiry_subject"
                placeholder="Product enquiry / Pricing / Export documentation"
                class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none"
                onfocus="this.style.boxShadow='0 0 0 2px #0D948840'; this.style.borderColor='#0D9488';"
                onblur="this.style.boxShadow=''; this.style.borderColor='#e5e7eb';"
              />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message *</label>
              <textarea
                id="message"
                name="message"
                required
                rows={5}
                placeholder="Please describe your requirements — product names, quantities, destination country, etc."
                class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none resize-none"
                onfocus="this.style.boxShadow='0 0 0 2px #0D948840'; this.style.borderColor='#0D9488';"
                onblur="this.style.boxShadow=''; this.style.borderColor='#e5e7eb';"
              ></textarea>
            </div>
            <button
              type="submit"
              id="contact-submit"
              disabled={!isFormConfigured}
              aria-disabled={!isFormConfigured ? 'true' : 'false'}
              class="w-full py-3 px-6 rounded-lg font-semibold text-white hover:opacity-90 transition-opacity"
              style={`background-color: #0F1F54; ${!isFormConfigured ? 'opacity: 0.6; cursor: not-allowed;' : ''}`}
            >
              Send Enquiry
            </button>
            <p
              id="contact-form-status"
              class={`text-sm text-center ${isFormConfigured ? 'hidden text-gray-600' : 'text-amber-700'}`}
              aria-live="polite"
            >
              {isFormConfigured
                ? 'Sending...'
                : 'Set PUBLIC_WEB3FORMS_ACCESS_KEY in your environment before this form can send emails.'}
            </p>
            <p class="text-xs text-gray-400 text-center">
              We typically respond within 1–2 business days.
            </p>
          </form>
        </div>
      </div>

    </div>
  </section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitButton = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const status = document.getElementById('contact-form-status') as HTMLParagraphElement | null;
  const nameInput = document.getElementById('name') as HTMLInputElement | null;
  const enquirySubjectInput = document.getElementById('subject') as HTMLInputElement | null;
  const emailSubjectInput = document.getElementById('email-subject') as HTMLInputElement | null;
  const btn = document.getElementById('product-dropdown-btn') as HTMLButtonElement;
  const panel = document.getElementById('product-dropdown-panel') as HTMLElement;
  const label = document.getElementById('product-dropdown-label') as HTMLElement;
  const hidden = document.getElementById('product') as HTMLInputElement;
  const checkboxes = document.querySelectorAll<HTMLInputElement>('.product-checkbox');
  const isConfigured = form?.dataset.configured === 'true';

  function updateEmailSubject() {
    if (!emailSubjectInput) return;

    const name = nameInput?.value.trim();
    const enquiryTopic = enquirySubjectInput?.value.trim();

    if (name && enquiryTopic) {
      emailSubjectInput.value = `New Enquiry from ${name} - ${enquiryTopic}`;
      return;
    }

    if (name) {
      emailSubjectInput.value = `New Enquiry from ${name}`;
      return;
    }

    emailSubjectInput.value = 'New Enquiry from Ikvion Website';
  }

  function updateHidden() {
    const selected = Array.from(checkboxes).filter(c => c.checked).map(c => c.value);
    hidden.value = selected.join(', ');
    label.textContent = selected.length ? selected.join(', ') : 'Select products…';
    label.classList.toggle('text-gray-400', selected.length === 0);
    label.classList.toggle('text-gray-800', selected.length > 0);
  }

  checkboxes.forEach(cb => cb.addEventListener('change', updateHidden));
  nameInput?.addEventListener('input', updateEmailSubject);
  enquirySubjectInput?.addEventListener('input', updateEmailSubject);

  btn.addEventListener('click', () => {
    panel.classList.toggle('hidden');
  });

  document.addEventListener('click', e => {
    if (!btn.contains(e.target as Node) && !panel.contains(e.target as Node)) {
      panel.classList.add('hidden');
    }
  });

  // Pre-select from URL param
  const preselect = new URLSearchParams(window.location.search).get('product');
  if (preselect) {
    checkboxes.forEach(cb => {
      if (cb.value === preselect) cb.checked = true;
    });
    updateHidden();
  }

  updateEmailSubject();

  if (form && submitButton && status && isConfigured) {
    form.addEventListener('submit', async event => {
      event.preventDefault();
      updateEmailSubject();

      submitButton.disabled = true;
      submitButton.setAttribute('aria-disabled', 'true');
      submitButton.textContent = 'Sending...';
      status.textContent = 'Sending your enquiry...';
      status.classList.remove('hidden', 'text-red-600', 'text-green-700');
      status.classList.add('text-gray-600');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            Accept: 'application/json',
          },
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || 'Unable to send your enquiry right now.');
        }

        form.reset();
        checkboxes.forEach(cb => {
          cb.checked = false;
        });
        updateHidden();
        updateEmailSubject();
        panel.classList.add('hidden');

        status.textContent = 'Thanks. Your enquiry has been sent successfully.';
        status.classList.remove('text-gray-600', 'text-red-600');
        status.classList.add('text-green-700');
      } catch (error) {
        status.textContent = error instanceof Error
          ? error.message
          : 'Something went wrong while sending your enquiry.';
        status.classList.remove('text-gray-600', 'text-green-700');
        status.classList.add('text-red-600');
      } finally {
        submitButton.disabled = false;
        submitButton.setAttribute('aria-disabled', 'false');
        submitButton.textContent = 'Send Enquiry';
      }
    });
  }
</script>

</BaseLayout>
